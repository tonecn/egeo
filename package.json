{
  "name": "egeo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-07-18 --compatibility-flag=nodejs_compat",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p functions/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "mmdb-lib": "^2.1.0"
  }
}
